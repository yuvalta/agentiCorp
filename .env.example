# Agents run on the Claude subscription via the `claude` CLI — never a
# pay-per-token API key. ANTHROPIC_API_KEY is deliberately NOT used; if it is
# set, lib/llm.js warns and ignores it.
#
# Local dev: nothing to set — `claude` uses your existing login.
#
# Headless / VPS: generate a long-lived token on a machine with a browser
#   claude setup-token
# then export it in the shell that runs the agents. NOTE: nothing in this repo
# auto-loads .env (no dotenv, no --env-file), so exporting is required:
#   export CLAUDE_CODE_OAUTH_TOKEN=...
# CLAUDE_CODE_OAUTH_TOKEN=

# Override the CLI binary path if `claude` is not on PATH.
# CLAUDE_CLI=/root/.local/bin/claude

# Per-call timeout in ms (default 600000).
# CLAUDE_TIMEOUT_MS=600000

# Set to false to skip the per-call spend ledger write (reduces file I/O).
# SPEND_TRACKING=false
